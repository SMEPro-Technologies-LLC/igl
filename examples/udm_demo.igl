# udm_demo.igl
# Demonstrates UDM (Universal Deterministic Model) blocks.
# A UDM block guarantees deterministic, referential-transparent computation.

udm fibonacci_10 {
    def fib(n) {
        if n <= 1 {
            return n
        }
        return fib(n - 1) + fib(n - 2)
    }
    resolve fib(10)
}

print("UDM fibonacci(10):")
print(fibonacci_10)

# Arrow pipe: compose operations
def double(x) {
    return x * 2
}

def inc(x) {
    return x + 1
}

let result = 5 -> double -> inc
print("5 -> double -> inc =")
print(result)
