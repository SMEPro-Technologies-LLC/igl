{
  "// ": "Type check for plain JavaScript (npm run typecheck). No emit; the compiler reads the code and its JSDoc and reports what does not add up.",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "noImplicitThis": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": false,
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["es2023", "dom"]
  },
  "include": ["bin/**/*.mjs", "src/**/*.js", "provision/**/*.mjs", "platform/api/src/**/*.js", "platform/ops/src/**/*.js"],
  "exclude": ["node_modules", "**/.wrangler/**", "provision/identities.mjs"]
}
