%igl 0.2

# =====================================================================
# Jordan Avery: Identity Graph · Individual · FOOTPRINT
#
# Generated from the graph's footprint:
#     granted  Action { triage-alert, acquire-disk-image, preserve-evidence,
#                       draft-incident-report }          (signed: CISO Office)
#     observed capture-volatile-memory x3 (governing layer,
#                                                         promotion candidate,
#                                                         not authority)
#     observed restore-production-systems x5 (proposed layer;
#                                              does not grant authority)
#
# Statement 1 uses a granted action. Statement 2 tries an observed action
# that was never granted, so IGL rejects it before calling the model.
# =====================================================================


# ---------------------------------------------------------------------
# 1. Run an action covered by the granted footprint.
# ---------------------------------------------------------------------
ID[Jordan_Avery:DFIR_Coordinator | Action:draft-incident-report]
  :: Intent[Execute_DFIR_Action]
  => Context[Traces=None],
     Compute[
       AI.Extract(Slots=[dfir_action], Model=distilgpt2-local, Seed=9),
       IOS.Trace(Channels=[Reasoning, Context])
     ]
  -> Output[Action_Record, TurnTrace_ID]
  OnFail[Remediate(Notify=CISO_Office)];


# ---------------------------------------------------------------------
# 2. This action was observed five times but was never granted.
#    IGL rejects it with IGL_FOOTPRINT_DENIED.
# ---------------------------------------------------------------------
ID[Jordan_Avery:DFIR_Coordinator | Action:restore-production-systems]
  :: Intent[Execute_DFIR_Action]
  => Context[Traces=None],
     Compute[
       AI.Extract(Slots=[dfir_action], Model=distilgpt2-local, Seed=9),
       IOS.Trace(Channels=[Reasoning, Context])
     ]
  -> Output[Action_Record, TurnTrace_ID]
  OnFail[Remediate(Notify=CISO_Office)];
