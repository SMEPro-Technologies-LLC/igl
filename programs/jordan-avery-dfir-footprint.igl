%igl 0.2

# =====================================================================
# Jordan Avery: Identity Graph · Individual · FOOTPRINT
#
# Generated after the graph fold computed this
# actor's footprint:
#     granted  Action { triage-alert, acquire-disk-image, preserve-evidence,
#                       draft-incident-report }          (signed: CISO Office)
#     observed capture-volatile-memory x3 anchored (governing layer,
#                                                   promotion candidate,
#                                                   not yet authority)
#     observed restore-production-systems x5 AI-class (proposed layer;
#                                                       never authority)
#
# Statement 1 runs a granted action. The automaton uses only granted
# actions. Statement 2 requests an observed but ungranted action, which
# authorization blocks before the model is called.
# =====================================================================


# ---------------------------------------------------------------------
# 1. Granted action: the model selects from the allowed actions.
# ---------------------------------------------------------------------
ID[Jordan_Avery:DFIR_Coordinator | Action:draft-incident-report]
  :: Intent[Execute_DFIR_Action]
  => Context[Traces=None],
     Compute[
       AI.Extract(Slots=[dfir_action], Model=distilgpt2-local, Seed=9),
       IOS.Trace(Channels=[Reasoning, Context])
     ]
  -> Output[Action_Record, TurnTrace_ID]
  OnFail[Remediate(Notify=CISO_Office)];


# ---------------------------------------------------------------------
# 2. Observed but ungranted action, blocked by the footprint.
#    The graph recorded five AI-class observations of this action. It is
#    not in the granted footprint, so authorization returns
#    IGL_FOOTPRINT_DENIED before the model is called.
# ---------------------------------------------------------------------
ID[Jordan_Avery:DFIR_Coordinator | Action:restore-production-systems]
  :: Intent[Execute_DFIR_Action]
  => Context[Traces=None],
     Compute[
       AI.Extract(Slots=[dfir_action], Model=distilgpt2-local, Seed=9),
       IOS.Trace(Channels=[Reasoning, Context])
     ]
  -> Output[Action_Record, TurnTrace_ID]
  OnFail[Remediate(Notify=CISO_Office)];
