%igl 0.2

# =====================================================================
# Jordan Avery — Identity Graph · Individual · FOOTPRINT
#
# Generated by IOS orchestration AFTER the graph fold computed this
# actor's footprint:
#     granted  Action { triage-alert, acquire-disk-image, preserve-evidence,
#                       draft-incident-report }          (signed: CISO Office)
#     observed capture-volatile-memory x3 anchored       (governing layer —
#                                                         promotion candidate,
#                                                         NOT yet authority)
#     observed restore-production-systems x5 AI-class    (proposed layer —
#                                                         can NEVER promote)
#
# Statement 1 runs a granted action: the decode automaton is compiled from
# the granted set only. Statement 2 asserts an AI-observed action the graph
# has seen five times — and the language refuses it at the authz phase,
# before any model is paid for. Observation is not authority.
# =====================================================================


# ---------------------------------------------------------------------
# 1. Granted action — executes; the model selects inside the footprint.
# ---------------------------------------------------------------------
ID[Jordan_Avery:DFIR_Coordinator | Action:draft-incident-report]
  :: Intent[Execute_DFIR_Action]
  => Context[Traces=None],
     Compute[
       AI.Extract(Slots=[dfir_action], Model=distilgpt2-local, Seed=9),
       IOS.Trace(Channels=[Reasoning, Context])
     ]
  -> Output[Action_Record, TurnTrace_ID]
  OnFail[Remediate(Notify=CISO_Office)];


# ---------------------------------------------------------------------
# 2. Observed-but-never-granted action — REFUSED.
#    The graph has watched this actor near restore-production-systems
#    five times. All AI-class. The footprint does not cover the boundary,
#    so this statement fails at footprint containment: IGL_FOOTPRINT_DENIED.
# ---------------------------------------------------------------------
ID[Jordan_Avery:DFIR_Coordinator | Action:restore-production-systems]
  :: Intent[Execute_DFIR_Action]
  => Context[Traces=None],
     Compute[
       AI.Extract(Slots=[dfir_action], Model=distilgpt2-local, Seed=9),
       IOS.Trace(Channels=[Reasoning, Context])
     ]
  -> Output[Action_Record, TurnTrace_ID]
  OnFail[Remediate(Notify=CISO_Office)];
