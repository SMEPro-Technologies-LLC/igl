%igl 0.2

# =====================================================================
# Hilcorp Energy — Identity Graph · Company · BOUNDARY
#
# Generated by IOS orchestration AFTER the graph fold computed this
# actor's granted footprint:
#     granted  Jurisdiction { US-TX, US-NM, US-LA }  Commodity { Oil, Gas, NGL }
#     observed US-CA x3 (AI-class — proposed layer only, never authority)
#
# The model inside AI.Extract does not read this boundary as text. The
# bridge (gamma) compiles the granted set into a prefix automaton over
# the model's own tokenizer, so at every sampling step only tokens that
# continue a boundary-covered value carry probability mass. Everything
# else is -inf. That is the AI operating AS this program DURING its
# numerical computation.
# =====================================================================


# ---------------------------------------------------------------------
# 1. Compliance packet at the home boundary.
#    UDM resolves the governed form set deterministically; AI.Extract
#    selects jurisdiction + commodity INSIDE the granted footprint.
# ---------------------------------------------------------------------
ID[Hilcorp_Energy:Operator | Jurisdiction:US-TX, Period:2026-Q3]
  :: Intent[Generate_Compliance_Packet, Mode=Full]
  => Context[Traces=None],
     Compute[
       UDM.Resolve(AgencyCode=TX-RRC, RequiredForms=[PR-202], Period=2026-Q3),
       AI.Extract(Slots=[jurisdiction, commodity], Model=distilgpt2-local, Seed=5),
       IOS.Trace(Channels=[Reasoning, Context])
     ]
  -> Output[Compliance_Packet, TurnTrace_ID]
  OnFail[Remediate(Notify=compliance_lead)];


# ---------------------------------------------------------------------
# 2. File the production report at a SPECIALISED boundary.
#    TX-RRC is narrower than the granted US-TX; the lattice covers it.
#    Filing requires attestation — nothing leaves without a keyed signer.
# ---------------------------------------------------------------------
ID[Hilcorp_Energy:Operator | Jurisdiction:TX-RRC, Period:2026-Q3, Commodity:Gas]
  :: Intent[File_Production_Report, Mode=Full]
  => Context[Traces=Recent(5)],
     Compute[
       UDM.Validate(Target=@Compliance_Packet, Ruleset=production_integrity),
       IOS.Attest(Signer=SMEPro_Governance_Board, Role=Compliance, Note="PR-202 packet reviewed against granted footprint"),
       IOS.Trace(Channels=[Reasoning, Context])
     ]
  -> Output[Filed_Report, TurnTrace_ID]
  OnFail[Remediate(Notify=compliance_lead)];
