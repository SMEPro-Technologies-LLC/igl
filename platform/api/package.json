{
  "name": "igl-platform-api",
  "version": "1.4.0",
  "private": true,
  "description": "IGL Governed Identity Platform API: the service behind api.id-me.ai and sandbox.id-me.ai, implementing spec/openapi.yaml on Cloudflare Workers and D1",
  "type": "module",
  "scripts": {
    "routes": "python3 scripts/gen-routes.py ../../spec/openapi.yaml src/routes.generated.js",
    "schema:local": "wrangler d1 execute igl-api-local --local --file=schema.sql",
    "dev": "wrangler dev --port 8801 --local --var IGL_ENV:sandbox --var RATE_BURST:100000",
    "test": "node scripts/test.mjs",
    "deploy:sandbox": "wrangler deploy --env sandbox",
    "deploy:production": "wrangler deploy --env production"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "wrangler": "^4.156.0",
    "yaml": "^2.6.0"
  }
}
