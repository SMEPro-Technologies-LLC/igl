{
  "name": "igl",
  "version": "1.7.0",
  "description": "Identity Governed Logic, a language and runtime where identity, boundaries, intent, and trace are bound into the computation itself",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./runtime": "./src/runtime.js"
  },
  "files": [
    "bin/",
    "src/",
    "spec/openapi.yaml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "SECURITY.md"
  ],
  "scripts": {
    "test": "node --test test/bridge.test.js test/decode.test.js test/extract.test.js test/graph.test.js test/igl.test.js test/sign.test.js test/store.test.js test/security.test.js test/resolver.test.js test/audit.test.js test/cli.test.js",
    "provision": "node provision/server.mjs",
    "provision:cli": "node provision/cli.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run lint && npm run typecheck && npm test",
    "demo": "node bin/igl.mjs demo"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SMEPro-Technologies-LLC/igl.git"
  },
  "keywords": [
    "identity",
    "governance",
    "ai-agents",
    "ai-alignment",
    "audit-trail",
    "hash-chain",
    "merkle",
    "ed25519",
    "receipts",
    "mcp",
    "compliance",
    "language",
    "runtime"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0"
  },
  "overrides": {
    "onnxruntime-web": "^1.23.0",
    "protobufjs": "^7.6.2",
    "sharp": "^0.35.3",
    "adm-zip": "^0.6.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "26.6.5",
    "eslint": "9.39.1",
    "globals": "17.13.0",
    "typescript": "5.9.3"
  },
  "bin": {
    "igl": "bin/igl.mjs"
  }
}
