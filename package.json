{
  "name": "igl",
  "version": "1.2.1",
  "description": "A Node.js language and runtime that checks identity, action boundaries, and intent, then records execution in an auditable trace",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./runtime": "./src/runtime.js"
  },
  "scripts": {
    "test": "node --test test/bridge.test.js test/decode.test.js test/extract.test.js test/graph.test.js test/igl.test.js test/sign.test.js test/store.test.js",
    "provision": "node provision/server.mjs",
    "provision:cli": "node provision/cli.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SMEPro-Technologies-LLC/igl.git"
  },
  "keywords": [
    "identity",
    "governance",
    "ai-alignment",
    "language",
    "runtime",
    "audit-trail",
    "compliance"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0"
  },
  "overrides": {
    "onnxruntime-web": "^1.23.0",
    "protobufjs": "^7.6.2",
    "sharp": "^0.35.3",
    "adm-zip": "^0.6.0"
  }
}
